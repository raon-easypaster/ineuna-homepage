# MongoDB Atlas 접속 문자열 — 찬양콘티와 같은 클러스터를 쓰되,
# 이 홈페이지 전용 DB 사용자(ineuna_auth DB에만 readWrite 권한)로 만드세요.
MONGODB_URI=mongodb+srv://ineuna_admin:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 홈페이지 전용 데이터베이스 이름 (찬양콘티 DB와 분리)
MONGODB_DB=ineuna_auth
# 세션 서명용 비밀값 — 32자 이상 무작위 문자열
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
